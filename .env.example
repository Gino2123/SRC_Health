POSTGRES_DB=health_v1
POSTGRES_USER=health
POSTGRES_PASSWORD=change-me-for-local-development

DATABASE_URL=postgresql+asyncpg://health:change-me-for-local-development@localhost:5432/health_v1
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Generate a random secret for each environment; never commit the real value.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
